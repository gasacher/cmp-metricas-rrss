{# ============================================================ Slide - Cierre #}
<section class="slide">
  <div class="closing">
    <h1>¡Gracias!</h1>
    <img src="{{ logo_uri }}" alt="">
  </div>
</section>

<script>
  /* =========================================================================
   * Identificador del informe — usado para que cada mes tenga sus propios
   * comentarios persistidos en localStorage independientes.
   * ========================================================================= */
  const REPORT_ID = "{{ d.mes }}";
  const REPORT_LABEL = "{{ d.mes_label }}";
  const STORAGE_KEY = `cmp-comentarios-${REPORT_ID}`;

  /* =========================================================================
   * Wrap slides + agrega caja de comentarios + numera
   * ========================================================================= */
  (function () {
    const slides = Array.from(document.querySelectorAll('section.slide'));
    const titulos = [];   // título visible de cada slide para el email

    slides.forEach((slide, idx) => {
      const slideNumber = idx + 1;

      // Título: tomamos h1 o h2 del slide
      const heading = slide.querySelector('h1, h2');
      const titulo = heading ? heading.textContent.trim().replace(/\s+/g, ' ') : `Slide ${slideNumber}`;
      titulos.push(titulo);

      // Numerar (excepto la portada)
      if (idx > 0) {
        const num = document.createElement('div');
        num.className = 'slide-number';
        num.textContent = `${slideNumber} / ${slides.length}`;
        slide.appendChild(num);
      }

      // Wrap del slide
      const wrap = document.createElement('div');
      wrap.className = 'slide-wrap';
      slide.parentNode.insertBefore(wrap, slide);
      wrap.appendChild(slide);

      // Caja de comentarios (no en la portada ni en "Gracias")
      const esPortada = idx === 0;
      const esCierre = idx === slides.length - 1;
      if (!esPortada && !esCierre) {
        const cb = document.createElement('div');
        cb.className = 'comment-box';
        cb.innerHTML = `
          <div class="icon">${slideNumber}</div>
          <div class="body">
            <div class="label">Comentarios — Slide ${slideNumber}: ${titulo}</div>
            <textarea data-slide="${slideNumber}" data-titulo="${titulo.replace(/"/g, '&quot;')}"
              placeholder="Escribí acá tus observaciones sobre este slide…"></textarea>
            <div class="saved">✓ Guardado</div>
          </div>
        `;
        wrap.parentNode.insertBefore(cb, wrap.nextSibling);
      }
    });
    window._reportTitulos = titulos;

    /* ===== Persistencia con localStorage ===== */
    function cargarComentarios() {
      try {
        const data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        document.querySelectorAll('.comment-box textarea').forEach(t => {
          const num = t.dataset.slide;
          if (data[num]) t.value = data[num];
        });
        actualizarContador();
      } catch (e) {}
    }
    function guardarComentarios(showSaved = false) {
      const data = {};
      document.querySelectorAll('.comment-box textarea').forEach(t => {
        const num = t.dataset.slide;
        if (t.value.trim()) data[num] = t.value;
      });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      actualizarContador();
      if (showSaved) {
        document.querySelectorAll('.comment-box .saved').forEach(s => {
          s.classList.add('show');
          setTimeout(() => s.classList.remove('show'), 1200);
        });
      }
    }
    function actualizarContador() {
      const data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      const n = Object.keys(data).length;
      const el = document.getElementById('commentCount');
      if (el) el.textContent = `${n} comentario${n === 1 ? '' : 's'}`;
    }

    let saveTimer;
    document.addEventListener('input', e => {
      if (e.target.matches('.comment-box textarea')) {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => guardarComentarios(true), 400);
      }
    });

    /* ===== Exportar comentarios ===== */
    window.exportarComentarios = function () {
      const data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      const numeros = Object.keys(data).map(Number).sort((a,b) => a-b);
      if (numeros.length === 0) {
        alert('Todavía no hay comentarios cargados. Escribí tus observaciones en los recuadros amarillos debajo de cada slide.');
        return;
      }
      const lineas = [`Comentarios sobre el reporte — ${REPORT_LABEL}`, ''];
      numeros.forEach(num => {
        const t = document.querySelector(`textarea[data-slide="${num}"]`);
        const titulo = t ? t.dataset.titulo : '';
        lineas.push(`──── Slide ${num} · ${titulo} ────`);
        lineas.push(data[num].trim());
        lineas.push('');
      });
      const cuerpo = lineas.join('\n');
      const subject = encodeURIComponent(`Comentarios reporte CMP ${REPORT_LABEL}`);
      const body = encodeURIComponent(cuerpo);
      // Abre el cliente de email
      const mailto = `mailto:?subject=${subject}&body=${body}`;
      window.location.href = mailto;
      // Y como respaldo, copia al portapapeles
      navigator.clipboard?.writeText(cuerpo).catch(()=>{});
    };

    window.limpiarComentarios = function () {
      if (!confirm('¿Borrar todos los comentarios cargados? Esta acción no se puede deshacer.')) return;
      localStorage.removeItem(STORAGE_KEY);
      document.querySelectorAll('.comment-box textarea').forEach(t => t.value = '');
      actualizarContador();
    };

    /* ===== Escala responsive ===== */
    function fit() {
      document.querySelectorAll('.slide-wrap').forEach(w => {
        const slide = w.querySelector('.slide');
        if (!slide) return;
        const wrapW = w.clientWidth;
        const scale = wrapW / 1920;
        slide.style.transform = `scale(${scale})`;
        w.style.height = (1080 * scale) + 'px';
      });
    }

    window.addEventListener('load', () => { fit(); cargarComentarios(); });
    window.addEventListener('resize', fit);
    fit();
    cargarComentarios();
  })();
</script>

</body>
</html>
