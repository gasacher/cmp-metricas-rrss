  <div class="logo"><img src="{{ logo_uri }}" alt=""></div>

  <div class="glosario-grid" style="margin-top: 22px;">
    <div class="gloss-item">
      <span class="gloss-num">1</span>
      <div class="gloss-body">
        <div class="term">Alcance / Miembros alcanzados <span style="font-size:14px;font-weight:600;color:var(--gris-text);">(LinkedIn)</span></div>
        <div class="def">Personas únicas que vieron una publicación al menos una vez.</div>
      </div>
    </div>
