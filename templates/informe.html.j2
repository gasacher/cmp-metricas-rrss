<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
<meta name="googlebot" content="noindex, nofollow">
<title>Reporte métricas RRSS — {{ d.mes_label }}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    /* Fuerza a imprimir colores de fondo y gradientes */
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    color-adjust: exact !important;
  }
  html, body {
    font-family: 'Inter', -apple-system, sans-serif;
    color: #0f172a;
    background: #e2e8f0;
  }

  :root {
    --verde-lima: #B7E04D;
    --verde-cmp: #2DAA9E;
    --verde-cmp-osc: #1b6e66;
    --gris-claro: #f1f5f9;
    --gris-medio: #cbd5e1;
    --gris-text: #475569;
    --rojo: #dc2626;
    --verde-up: #16a34a;
    --amarillo: #fbbf24;
    --azul: #6366f1;
    --violeta: #a855f7;
    --naranja: #f59e0b;
    --rojo-yt: #ff0000;
    --img-compare-h: 400px;
  }

  /* ===== Slide 16:9 escalable a cualquier pantalla ===== */
  .slide-wrap {
    position: relative;
    width: 100%;
    max-width: 1600px;
    margin: 28px auto;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(15, 23, 42, 0.12);
  }
  .slide {
    width: 1920px;
    height: 1080px;
    background: #ffffff;
    position: relative;
    overflow: hidden;
    padding: 70px 90px;
    transform-origin: top left;
    page-break-after: always;
  }
  .slide:last-child { page-break-after: auto; }
  .slide::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 28px;
    background: var(--verde-lima);
  }

  .logo {
    position: absolute;
    top: 60px;
    right: 90px;
    width: 320px;
  }
  .logo img { width: 100%; display: block; }

  /* ===== Tipografía base ===== */
  h1.title-xl {
    font-size: 132px;
    font-weight: 900;
    letter-spacing: -2px;
    line-height: 1;
  }
  h2.title-lg {
    font-size: 88px;
    font-weight: 900;
    letter-spacing: -1.5px;
    line-height: 1;
  }
  .subtitle {
    font-size: 32px;
    font-weight: 300;
    color: #1e293b;
    margin-top: 12px;
  }

  /* ===== Tag "KPI principal" ===== */
  .kpi-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }
  .kpi-badge::before { content: "★"; }

  /* ===== Portada (laptop + texto: .laptop es hermano de .cover, no hijo) ===== */
  .slide-cover {
    position: relative;
    overflow: hidden;
  }
  .slide-cover .cover {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(1080px - 140px);
    position: relative;
    z-index: 2;
    max-width: 46%;
    padding-right: 12px;
  }
  .slide-cover .cover .title-xl {
    font-size: 128px;
    line-height: 0.98;
  }
  .slide-cover .cover .subtitle {
    font-size: 28px;
    margin-top: 10px;
  }
  .slide-cover .cover .logo-cover {
    margin-top: 44px;
    width: 320px;
    max-width: 100%;
  }
  .slide-cover .laptop {
    position: absolute;
    right: 90px;
    top: 70px;
    bottom: 70px;
    width: 54%;
    max-width: 1020px;
    z-index: 1;
    pointer-events: none;
    min-width: 0;
    min-height: 0;
  }
  .slide-cover .laptop img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center right;
    display: block;
  }

  /* ===== Apertura: una sola slide «En foco» (sin capturas) ===== */
  .slide.slide--exec-dash {
    display: flex;
    flex-direction: column;
    padding-top: 0;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 56px;
  }
  .slide.slide--exec-dash .logo {
    right: 90px;
    top: 52px;
  }
  .slide.slide--exec-dash .exec-dash-bar {
    margin: 0 0 0 0;
    padding: 36px 90px 32px 118px;
    background: linear-gradient(105deg, #0f172a 0%, #134e4a 55%, #0f172a 100%);
    color: #fff;
    position: relative;
    flex-shrink: 0;
  }
  .slide.slide--exec-dash .exec-dash-bar::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 28px;
    background: var(--verde-lima);
  }
  .slide.slide--exec-dash .exec-dash-kicker {
    font-size: 17px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #a7f3d0;
    margin-bottom: 6px;
  }
  .slide.slide--exec-dash .exec-dash-title {
    font-size: 52px;
    font-weight: 900;
    letter-spacing: -1px;
    line-height: 1.05;
  }
  .slide.slide--exec-dash .exec-dash-sub {
    margin-top: 10px;
    font-size: 22px;
    font-weight: 400;
    color: #cbd5e1;
    max-width: 1100px;
    line-height: 1.35;
  }
  .slide.slide--exec-dash .exec-dash-body {
    padding: 28px 90px 0 118px;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .slide.slide--exec-dash .exec-dash-kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    flex-shrink: 0;
  }
  .slide.slide--exec-dash .exec-dash-kpi {
    background: var(--gris-claro);
    border-radius: 12px;
    padding: 14px 16px 12px;
    border: 1px solid var(--gris-medio);
  }
  .slide.slide--exec-dash .exec-dash-kpi.exec-dash-kpi--muted {
    opacity: 0.75;
  }
  .slide.slide--exec-dash .exec-dash-kpi .dk-l {
    font-size: 12px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    text-transform: uppercase;
    letter-spacing: 0.4px;
    line-height: 1.2;
  }
  .slide.slide--exec-dash .exec-dash-kpi .dk-v {
    font-size: 36px;
    font-weight: 900;
    color: #0f172a;
    margin-top: 4px;
    line-height: 1;
  }
  .slide.slide--exec-dash .exec-dash-kpi .dk-d {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 700;
  }
  .slide.slide--exec-dash .exec-dash-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 22px;
    flex: 1;
    min-height: 0;
    align-items: stretch;
  }
  .slide.slide--exec-dash .exec-dash-h3 {
    font-size: 16px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin: 0 0 8px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .slide.slide--exec-dash .exec-dash-h3::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, currentColor 0%, transparent 100%);
    opacity: 0.22;
    min-width: 24px;
  }
  .slide.slide--exec-dash .exec-dash-panel-paso .exec-dash-h3 {
    color: #334155;
  }
  .slide.slide--exec-dash .exec-dash-panel-hacer .exec-dash-h3 {
    color: #0f766e;
  }
  .slide.slide--exec-dash .exec-dash-panel-paso .exec-dash-h3::after {
    background: linear-gradient(90deg, #94a3b8 0%, transparent 100%);
    opacity: 0.35;
  }
  .slide.slide--exec-dash .exec-dash-panel-hacer .exec-dash-h3::after {
    background: linear-gradient(90deg, #5eead4 0%, transparent 100%);
    opacity: 0.45;
  }
  .slide.slide--exec-dash .exec-dash-puntos {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Panel «Qué pasó»: lecturas en tarjetas alineadas con «Qué hacer» */
  .slide.slide--exec-dash .exec-dash-panel-paso {
    background: linear-gradient(165deg, #f8fafc 0%, #f1f5f9 45%, #e2e8f0 100%);
    border-radius: 16px;
    border: 1px solid #cbd5e1;
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    min-height: 0;
    box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
  }
  .slide.slide--exec-dash .exec-dash-panel-paso .exec-dash-puntos {
    counter-reset: exec-punto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    min-height: 0;
  }
  .slide.slide--exec-dash .exec-dash-panel-paso .exec-dash-puntos li {
    counter-increment: exec-punto;
    position: relative;
    margin: 0;
    padding: 18px 20px 18px 58px;
    font-size: 22px;
    line-height: 1.48;
    color: #0f172a;
    background: #fff;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
  }
  .slide.slide--exec-dash .exec-dash-panel-paso .exec-dash-puntos li::before {
    content: counter(exec-punto);
    position: absolute;
    left: 16px;
    top: 20px;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(145deg, #64748b 0%, #1e293b 100%);
    color: #fff;
    font-size: 15px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(30, 41, 59, 0.25);
  }
  .slide.slide--exec-dash .exec-dash-panel-paso .exec-dash-puntos li b {
    color: var(--verde-cmp-osc);
    font-weight: 800;
  }
  .slide.slide--exec-dash .exec-dash-hint {
    font-size: 15px;
    font-weight: 500;
    color: #64748b;
    margin: 0 0 14px 0;
    line-height: 1.45;
    max-width: 100%;
  }
  .slide.slide--exec-dash .exec-dash-hint code {
    font-size: 13px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .slide.slide--exec-dash .exec-dash-panel-paso .exec-dash-hint code {
    color: #1e40af;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #bfdbfe;
  }
  /* Panel «Qué hacer»: prioridades con mismo ritmo visual que la izquierda */
  .slide.slide--exec-dash .exec-dash-panel-hacer {
    background: linear-gradient(165deg, #ecfdf5 0%, #f8fafc 42%, #f1f5f9 100%);
    border-radius: 16px;
    border: 1px solid #bbf7d0;
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    min-height: 0;
    box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
  }
  .slide.slide--exec-dash .exec-dash-panel-hacer .exec-dash-hint code {
    color: #0f766e;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #d1fae5;
  }
  .slide.slide--exec-dash .exec-dash-actions-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    min-height: 0;
  }
  .slide.slide--exec-dash .exec-dash-act-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex: 1;
    min-height: 0;
    background: #fff;
    border-radius: 14px;
    padding: 18px 20px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
  }
  .slide.slide--exec-dash .exec-dash-act-num {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(145deg, var(--verde-cmp) 0%, #0d9488 100%);
    color: #fff;
    font-size: 17px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(13, 148, 136, 0.35);
  }
  .slide.slide--exec-dash .exec-dash-act-text {
    font-size: 22px;
    line-height: 1.48;
    color: #0f172a;
    padding-top: 4px;
  }
  .slide.slide--exec-dash .exec-dash-act-text b {
    color: var(--verde-cmp-osc);
    font-weight: 800;
  }

  /* ===== Glosario ===== */
  .glosario-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 60px;
    margin-top: 30px;
  }
  .gloss-item {
    border-left: 6px solid var(--verde-cmp);
    padding: 6px 18px;
    display: flex;
    align-items: flex-start;
  }
  .gloss-item .term {
    font-size: 26px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
  }
  .gloss-item .def {
    font-size: 20px;
    color: #1e293b;
    line-height: 1.4;
    margin-top: 4px;
  }
  .gloss-intro {
    font-size: 22px;
    line-height: 1.55;
    color: #334155;
    background: var(--gris-claro);
    border-radius: 12px;
    padding: 22px 28px;
    margin-top: 24px;
    border-left: 6px solid var(--verde-cmp);
  }
  .gloss-intro strong { color: var(--verde-cmp-osc); }
  .gloss-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    font-weight: 900;
    font-size: 20px;
    border-radius: 8px;
    margin-right: 12px;
    flex-shrink: 0;
  }
  .gloss-item .gloss-body { flex: 1; min-width: 0; }

  /* ===== KPI principal destacado (la estrella) ===== */
  .hero-kpi {
    background: linear-gradient(135deg, #B7E04D 0%, #2DAA9E 100%);
    /* Color sólido como respaldo si el navegador no imprime gradientes */
    background-color: #2DAA9E;
    color: white;
    padding: 26px 36px;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(45, 170, 158, 0.35);
    display: flex;
    align-items: center;
    justify-content: space-between;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .hero-kpi .left { flex: 1; }
  .hero-kpi .label {
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: 0.95;
  }
  .hero-kpi .value {
    font-size: 118px;
    font-weight: 900;
    line-height: 1;
    margin-top: 8px;
    letter-spacing: -3px;
  }
  .hero-kpi .delta {
    font-size: 36px;
    font-weight: 800;
    margin-top: 8px;
  }
  .hero-kpi .right {
    text-align: right;
    opacity: 0.95;
  }
  .hero-kpi .right .compare-label { font-size: 16px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9; }
  .hero-kpi .right .compare-value { font-size: 56px; font-weight: 700; }

  /* ===== KPIs secundarios (chips) ===== */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 24px 0;
  }
  .kpi {
    background: var(--gris-claro);
    border-left: 6px solid var(--verde-cmp);
    padding: 18px 22px;
    border-radius: 10px;
  }
  .kpi .label {
    font-size: 18px;
    color: var(--gris-text);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .kpi .value {
    font-size: 48px;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.1;
    margin-top: 4px;
  }
  .kpi .delta { font-size: 22px; font-weight: 700; margin-top: 4px; }

  .delta.up   { color: var(--verde-up); }
  .delta.down { color: var(--rojo); }
  .delta.flat { color: var(--gris-text); }
  /* Sobre fondo de color (hero-kpi) las flechas se ven blancas */
  .hero-kpi .delta.up   { color: white; }
  .hero-kpi .delta.down { color: #fee2e2; }
  .hero-kpi .delta.flat { color: rgba(255,255,255,0.85); }

  /* ===== Comparativa anterior vs actual (sin hero) ===== */
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 24px;
  }
  .compare .col {
    background: var(--gris-claro);
    border-radius: 12px;
    padding: 22px;
  }
  .compare .col h3 {
    font-size: 24px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .compare .col .range { font-size: 16px; color: var(--gris-text); margin-bottom: 14px; }
  .compare .col .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 14px;
  }
  .compare .col .stat .v { font-size: 34px; font-weight: 900; }
  .compare .col .stat .l { font-size: 14px; color: var(--gris-text); font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }
  /* Capturas comparativas (seguidores / visitantes): imagen rellena el marco sin recortar contenido */
  .compare .col .img-wrap {
    position: relative;
    background: white;
    border: 1px solid var(--gris-medio);
    border-radius: 8px;
    overflow: hidden;
    height: var(--img-compare-h, 400px);
    box-sizing: border-box;
  }
  .compare .col .img-wrap img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
  }
  .compare .col .img-wrap .placeholder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    color: var(--gris-medio);
    font-size: 18px;
    text-align: center;
    line-height: 1.4;
  }

  /* Marco único de captura (LinkedIn, YouTube, Web, Luciana, etc.) */
  .capture-frame {
    position: relative;
    background: #fff;
    border: 1px solid var(--gris-medio);
    border-radius: 12px;
    overflow: hidden;
    display: block;
    margin-top: 14px;
    box-sizing: border-box;
  }
  .capture-frame img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
  }
  .capture-frame .placeholder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: var(--gris-text);
    font-size: 16px;
    text-align: center;
    line-height: 1.45;
  }
  .capture-double {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
    align-items: start;
  }
  .capture-double .col {
    background: var(--gris-claro);
    border-radius: 12px;
    padding: 14px 16px 16px;
    min-width: 0;
    min-height: 0;
  }
  .capture-double .col h4 {
    font-size: 15px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .capture-double .col .capture-frame { margin-top: 0; width: 100%; }
  /* Alturas de marco (la imagen escala con object-fit dentro del alto fijo) */
  .h-cap-sm { height: 320px; box-sizing: border-box; }
  .h-cap-md { height: 420px; box-sizing: border-box; }
  .h-cap-lg { height: 500px; box-sizing: border-box; }

  /* Descubrimiento orgánico: recorte visual sobre la captura completa */
  .capture-frame.pub-organic-cap img {
    object-fit: cover;
    object-position: 50% 24%;
  }
  /* Seguidores: enfatizar zona superior tipo «Datos destacados» */
  .capture-frame.seguidores-destacados-cap img {
    object-fit: cover;
    object-position: center top;
  }

  /*
   * Slides con mucho KPI + capturas: el slide mide 1080px y overflow:hidden
   * recortaba la parte inferior. .slide--fill + .fill-grow reparten el alto:
   * las capturas crecen (height:auto) solo en el espacio que sobra.
   */
  .slide.slide--fill {
    display: flex;
    flex-direction: column;
  }
  .slide.slide--fill > .fill-grow {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .slide.slide--fill .capture-double {
    flex: 1 1 0;
    min-height: 0;
    margin-top: 8px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(0, 1fr);
    gap: 12px;
    align-items: stretch;
  }
  .slide.slide--fill .capture-double .col {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
  }
  .slide.slide--fill .capture-double .col .capture-frame {
    flex: 1 1 auto;
    min-height: 120px;
    height: auto !important;
  }
  .slide.slide--fill .compare {
    flex: 1 1 0;
    min-height: 0;
    margin-top: 10px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .slide.slide--fill .compare .col {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
  }
  .slide.slide--fill .compare .col h3 {
    flex-shrink: 0;
    margin-bottom: 6px;
  }
  .slide.slide--fill .compare .col .img-wrap {
    flex: 1 1 auto;
    min-height: 120px;
    height: auto !important;
  }
  /* Publicación: bloque superior alto → scroll interno, capturas al resto */
  .slide.slide--fill.slide--pub .pub-scroll {
    flex: 0 1 auto;
    max-height: 340px;
    overflow: auto;
    min-height: 0;
  }
  .slide.slide--fill.slide--pub .capture-double {
    flex: 1 1 0;
    min-height: 0;
  }
  /* Web: tabla compacta para dejar aire a las gráficas */
  .slide.slide--fill.slide--web .web-stack-top {
    flex: 0 0 auto;
  }
  .slide.slide--fill.slide--web .capture-frame.web-cap-wide {
    position: relative;
    flex: 0 1 auto;
    min-height: 90px;
    max-height: 170px;
    width: 100%;
    height: auto !important;
  }
  .slide.slide--fill.slide--web .web-list--fit {
    flex: 0 0 auto;
    max-height: 160px;
  }
  /* Perfil — Contenido: grilla bajo cabecera flexible */
  .slide.slide--fill.slide--luciana-grid .fill-grow > .lc-grid {
    flex: 1 1 0;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: stretch;
  }
  .slide.slide--fill.slide--luciana-grid .lc-col-text {
    min-width: 0;
    min-height: 0;
    overflow: auto;
  }
  .slide.slide--fill.slide--luciana-grid .lc-grid > .lc-col-cap {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
  }
  .slide.slide--fill.slide--luciana-grid .lc-grid .capture-frame {
    flex: 1 1 auto;
    min-height: 120px;
    height: auto !important;
  }

  /* -------------------------------------------------------------------------
   * Hoja de capturas (2ª diapositiva): casi todo el alto para las imágenes.
   * Mejor legibilidad en PDF que KPI + captura en un solo 16:9.
   * ------------------------------------------------------------------------- */
  .slide.slide--sheet {
    display: flex;
    flex-direction: column;
    padding-top: 44px;
    padding-bottom: 40px;
  }
  .slide.slide--sheet .sheet-ribbon {
    flex: 0 0 auto;
    margin-bottom: 6px;
  }
  .slide.slide--sheet .sheet-ribbon h2 {
    font-size: 52px;
    font-weight: 900;
    letter-spacing: -1px;
    line-height: 1.05;
    color: #0f172a;
  }
  .slide.slide--sheet .sheet-ribbon .subtitle {
    margin-top: 6px;
    font-size: 22px;
    font-weight: 300;
    color: #1e293b;
  }
  .slide.slide--sheet .sheet-body {
    flex: 1 1 0;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: stretch;
    margin-top: 6px;
  }
  .slide.slide--sheet .sheet-body.sheet-web {
    grid-template-rows: minmax(0, 1fr) auto;
  }
  .slide.slide--sheet .sheet-body.sheet-web > .sheet-cell.sheet-row-full {
    grid-column: 1 / -1;
  }
  .slide.slide--sheet .sheet-body.sheet-body--single {
    grid-template-columns: 1fr;
  }
  .slide.slide--sheet .sheet-cell {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--gris-claro);
    border-radius: 14px;
    padding: 10px 12px 12px;
  }
  .slide.slide--sheet .sheet-cell h4 {
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .slide.slide--sheet .sheet-cap {
    flex: 1 1 0;
    min-height: 280px;
    position: relative;
    background: #fff;
    border: 1px solid var(--gris-medio);
    border-radius: 12px;
    overflow: hidden;
  }
  .slide.slide--sheet .sheet-cap.sheet-cap--short {
    flex: 0 1 auto;
    min-height: 200px;
    max-height: 360px;
  }
  .slide.slide--sheet .sheet-cap img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
  }
  .slide.slide--sheet .sheet-cap .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    font-size: 16px;
    color: var(--gris-text);
    line-height: 1.45;
  }

  /* Publicación — solo texto: más alto útil antes del slide de capturas */
  .slide.slide--pub-metrics {
    display: flex;
    flex-direction: column;
  }
  .slide.slide--pub-metrics .pub-scroll {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: 12px;
    max-height: 760px;
    overflow: auto;
  }

  .card {
    background: var(--gris-claro);
    border-radius: 12px;
    padding: 22px 26px;
  }
  .card h3 {
    font-size: 24px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    margin-bottom: 14px;
  }
  .card .stats-grid {
    display: grid;
    gap: 10px 24px;
  }
  .card .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid var(--gris-medio);
  }
  .card .row:last-child { border-bottom: 0; }
  .card .row .l { font-size: 18px; color: var(--gris-text); }
  .card .row .v { font-size: 26px; font-weight: 800; color: #0f172a; }

  /* ===== WhatsApp ===== */
  .wa-banner { text-align: center; font-size: 40px; font-weight: 800; margin: 30px 0 30px; }
  .wa-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .wa-card { background: #0f172a; color: white; border-radius: 12px; padding: 26px 22px; text-align: center; min-height: 300px; display: flex; flex-direction: column; justify-content: space-between; }
  .wa-card .badge { background: white; border-radius: 50%; width: 110px; height: 110px; margin: 0 auto; display: flex; align-items: center; justify-content: center; padding: 14px; }
  .wa-card .badge img { width: 100%; height: auto; object-fit: contain; }
  .wa-card .name { font-size: 18px; font-weight: 600; line-height: 1.3; margin-top: 14px; }
  .wa-card .members { font-size: 15px; color: var(--gris-medio); margin-top: 10px; }

  /* ===== Web ===== */
  .web-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .web-kpi { border-radius: 10px; padding: 18px 22px; color: white; }
  .web-kpi .l { font-size: 16px; opacity: 0.95; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
  .web-kpi .v { font-size: 40px; font-weight: 900; margin-top: 4px; }
  .web-kpi.k1 { background: var(--azul); }
  .web-kpi.k2 { background: var(--verde-cmp); }
  .web-kpi.k3 { background: var(--naranja); }
  .web-list { background: var(--gris-claro); border-radius: 12px; padding: 22px; margin-top: 18px; }
  .web-list--fit {
    max-height: 200px;
    overflow-y: auto;
    margin-top: 12px;
    padding: 14px 16px;
  }
  .web-list--fit .item { padding: 8px 0; }
  .web-list--fit .item .ttl { font-size: 15px; }
  .web-list--fit .item .url { font-size: 11px; }
  .web-list--fit .item .clics { font-size: 18px; }
  .web-list .item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--gris-medio); }
  .web-list .item:last-child { border-bottom: 0; }
  .web-list .item .ttl { font-size: 17px; font-weight: 700; }
  .web-list .item .url { font-size: 12px; color: var(--gris-text); }
  .web-list .item .clics { font-size: 22px; font-weight: 800; min-width: 70px; text-align: right; }
  .web-list .item .delta { font-size: 14px; font-weight: 700; min-width: 90px; text-align: right; }

  /* ===== YouTube ===== */
  .yt-icon {
    background: var(--rojo-yt);
    color: white;
    width: 90px; height: 64px;
    border-radius: 14px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 36px;
    margin-right: 16px;
    vertical-align: middle;
  }
  .yt-icon::after { content: "▶"; }

  /* ===== Bullets (conclusiones/oportunidades) ===== */
  .bullets { margin-top: 24px; }
  .bullets li {
    list-style: none;
    font-size: 26px;
    line-height: 1.5;
    padding: 16px 0 16px 56px;
    position: relative;
    color: #1e293b;
  }
  .bullets li::before {
    content: "✓";
    position: absolute;
    left: 0; top: 14px;
    width: 36px; height: 36px;
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    border-radius: 6px;
    font-weight: 900;
    font-size: 24px;
    display: flex; align-items: center; justify-content: center;
  }
  .bullets li b { color: #0f172a; }

  /* ===== Cierre ===== */
  .closing { display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%; text-align: center; }
  .closing h1 {
    font-size: 200px; font-weight: 900;
    background: linear-gradient(135deg, var(--verde-lima) 0%, var(--verde-cmp) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .closing img { margin-top: 40px; width: 380px; }

  /* ===== Avatar/Persona ===== */
  .person {
    display: flex; align-items: center; gap: 22px; margin-top: 18px;
  }
  .person .avatar {
    width: 110px; height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--verde-lima), var(--verde-cmp));
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 44px; font-weight: 900;
  }
  .person .info .name { font-size: 32px; font-weight: 800; }
  .person .info .role { font-size: 18px; color: var(--gris-text); }

  /* ===== Banner de revisión ===== */
  .review-banner {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #0f172a;
    color: white;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  }
  .review-banner .left { display: flex; align-items: center; gap: 16px; }
  .review-banner .badge {
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .review-banner .title { font-size: 17px; font-weight: 700; }
  .review-banner .subtitle { font-size: 12px; opacity: 0.7; margin-top: 2px; }
  .review-banner .actions { display: flex; gap: 10px; align-items: center; }
  .review-banner button {
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    border: 0;
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: inherit;
  }
  .review-banner button:hover { opacity: 0.9; }
  .review-banner button.secondary {
    background: transparent;
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
  }
  .review-banner .count {
    font-size: 12px;
    opacity: 0.7;
    margin-right: 8px;
  }

  /* ===== Hint de comentarios para mobile ===== */
  .review-hint {
    background: #fef3c7;
    color: #92400e;
    padding: 12px 32px;
    font-size: 13px;
    text-align: center;
    border-bottom: 1px solid #fbbf24;
  }
  .review-hint b { color: #78350f; }

  /* ===== Caja de comentarios bajo cada slide ===== */
  .comment-box {
    max-width: 1600px;
    margin: 0 auto 32px auto;
    background: #fef9c3;
    border: 2px solid #facc15;
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .comment-box .icon {
    background: #facc15;
    color: #78350f;
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-weight: 900;
  }
  .comment-box .body { flex: 1; }
  .comment-box .label {
    font-size: 13px;
    font-weight: 700;
    color: #78350f;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .comment-box textarea {
    width: 100%;
    border: 0;
    background: transparent;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.5;
    color: #1e293b;
    resize: vertical;
    min-height: 50px;
    outline: none;
  }
  .comment-box textarea::placeholder { color: #a16207; opacity: 0.6; }
  .comment-box .saved {
    font-size: 11px;
    color: #16a34a;
    font-weight: 700;
    margin-top: 4px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .comment-box .saved.show { opacity: 1; }

  /* ===== Numerito de slide ===== */
  .slide-number {
    position: absolute;
    bottom: 30px;
    right: 50px;
    font-size: 18px;
    color: var(--gris-medio);
    font-weight: 600;
  }

  /* ===== Impresión / PDF (Cmd+P → Guardar como PDF) =====
     Las capturas deben encajar en el marco sin scroll: el PDF no imprime bien
     el interior de cajas con overflow:auto. */
  @page { size: 1920px 1080px; margin: 0; }
  @media print {
    html, body {
      background: white !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .review-banner, .review-hint, .comment-box { display: none !important; }
    .toolbar { display: none !important; }
    .slide-number { display: none !important; }

    .slide-wrap {
      box-shadow: none !important;
      border-radius: 0 !important;
      max-width: none !important;
      margin: 0 !important;
      width: 1920px !important;
      height: 1080px !important;
    }
    .slide {
      margin: 0 !important;
      box-shadow: none !important;
      transform: none !important;
      overflow: hidden !important;
      page-break-after: always;
      break-after: page;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    :root {
      --img-compare-h: 360px;
    }
    .h-cap-sm { height: 300px !important; }
    .h-cap-md { height: 380px !important; }
    .h-cap-lg { height: 440px !important; }

    .capture-frame,
    .compare .col .img-wrap,
    .slide.slide--sheet .sheet-cap {
      overflow: hidden !important;
    }

    .capture-frame img,
    .compare .col .img-wrap img,
    .slide.slide--sheet .sheet-cap img,
    .slide-cover .laptop img {
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center center !important;
    }
    .slide-cover .laptop img {
      object-position: center right !important;
    }

    .web-list--fit {
      max-height: 220px !important;
      overflow: hidden !important;
    }
  }
</style>
</head>
<body>

<div class="review-banner">
  <div class="left">
    <span class="badge">Borrador para revisión</span>
    <div>
      <div class="title">Reporte métricas RRSS · {{ d.mes_label }}</div>
      <div class="subtitle">Cámara de Medios de Pago</div>
    </div>
  </div>
  <div class="actions">
    <span class="count" id="commentCount">0 comentarios</span>
    <button onclick="exportarComentarios()">Exportar comentarios</button>
    <button class="secondary" onclick="limpiarComentarios()" title="Limpiar todos los comentarios">×</button>
