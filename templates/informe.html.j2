{# ============================================================ Slide - Contenidos (KPI + capturas) #}
<section class="slide slide--fill slide--contenidos-combo">
  <h2 class="title-lg">Contenidos</h2>
  <div class="subtitle">{{ d.mes_label }} · <strong>LinkedIn</strong> — página de la Cámara de Medios de Pago · datos destacados</div>
  <div class="logo"><img src="{{ logo_uri }}" alt=""></div>

  <div class="fill-grow" style="margin-top: 10px; display: flex; flex-direction: column; gap: 12px; min-height: 0;">
    <div style="flex-shrink: 0;">
      <div class="kpi-badge">KPI principal</div>
      <div class="hero-kpi">
        <div class="left">
          <div class="label">Interacciones totales</div>
          <div class="value">{{ fmt_num(totales.contenidos.actual) }}</div>
          <div class="delta {{ delta_class(deltas.interacciones_total) }}">{{ delta_str(deltas.interacciones_total) }} vs {{ d.mes_anterior_label }}</div>
