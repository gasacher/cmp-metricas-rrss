<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
<meta name="googlebot" content="noindex, nofollow">
<title>Reporte métricas RRSS — {{ d.mes_label }}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    /* Fuerza a imprimir colores de fondo y gradientes */
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    color-adjust: exact !important;
  }
  html, body {
    font-family: 'Inter', -apple-system, sans-serif;
    color: #0f172a;
    background: #e2e8f0;
  }

  :root {
    --verde-lima: #B7E04D;
    --verde-cmp: #2DAA9E;
    --verde-cmp-osc: #1b6e66;
    --gris-claro: #f1f5f9;
    --gris-medio: #cbd5e1;
    --gris-text: #475569;
    --rojo: #dc2626;
    --verde-up: #16a34a;
    --amarillo: #fbbf24;
    --azul: #6366f1;
    --violeta: #a855f7;
    --naranja: #f59e0b;
    --rojo-yt: #ff0000;
  }

  /* ===== Slide 16:9 escalable a cualquier pantalla ===== */
  .slide-wrap {
    position: relative;
    width: 100%;
    max-width: 1600px;
    margin: 28px auto;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(15, 23, 42, 0.12);
  }
  .slide {
    width: 1920px;
    height: 1080px;
    background: #ffffff;
    position: relative;
    overflow: hidden;
    padding: 70px 90px;
    transform-origin: top left;
    page-break-after: always;
  }
  .slide:last-child { page-break-after: auto; }
  .slide::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 28px;
    background: var(--verde-lima);
  }

  .logo {
    position: absolute;
    top: 60px;
    right: 90px;
    width: 320px;
  }
  .logo img { width: 100%; display: block; }

  /* ===== Tipografía base ===== */
  h1.title-xl {
    font-size: 132px;
    font-weight: 900;
    letter-spacing: -2px;
    line-height: 1;
  }
  h2.title-lg {
    font-size: 88px;
    font-weight: 900;
    letter-spacing: -1.5px;
    line-height: 1;
  }
  .subtitle {
    font-size: 32px;
    font-weight: 300;
    color: #1e293b;
    margin-top: 12px;
  }

  /* ===== Tag "KPI principal" ===== */
  .kpi-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }
  .kpi-badge::before { content: "★"; }

  /* ===== Slide 1 - Portada ===== */
  .cover {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }
  .cover .title-xl { font-size: 156px; }
  .cover .logo-cover {
    margin-top: 60px;
    width: 380px;
  }
  .cover .deco {
    position: absolute;
    right: -80px; top: 0; bottom: 0;
    width: 50%;
    background: linear-gradient(135deg, var(--verde-lima) 0%, var(--verde-cmp) 100%);
    border-radius: 50% 0 0 50%;
    opacity: 0.92;
  }

  /* ===== Glosario ===== */
  .glosario-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 60px;
    margin-top: 30px;
  }
  .gloss-item {
    border-left: 6px solid var(--verde-cmp);
    padding: 6px 18px;
  }
  .gloss-item .term {
    font-size: 26px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
  }
  .gloss-item .def {
    font-size: 20px;
    color: #1e293b;
    line-height: 1.4;
    margin-top: 4px;
  }

  /* ===== KPI principal destacado (la estrella) ===== */
  .hero-kpi {
    background: linear-gradient(135deg, #B7E04D 0%, #2DAA9E 100%);
    /* Color sólido como respaldo si el navegador no imprime gradientes */
    background-color: #2DAA9E;
    color: white;
    padding: 32px 40px;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(45, 170, 158, 0.35);
    display: flex;
    align-items: center;
    justify-content: space-between;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .hero-kpi .left { flex: 1; }
  .hero-kpi .label {
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: 0.95;
  }
  .hero-kpi .value {
    font-size: 140px;
    font-weight: 900;
    line-height: 1;
    margin-top: 8px;
    letter-spacing: -3px;
  }
  .hero-kpi .delta {
    font-size: 36px;
    font-weight: 800;
    margin-top: 8px;
  }
  .hero-kpi .right {
    text-align: right;
    opacity: 0.95;
  }
  .hero-kpi .right .compare-label { font-size: 16px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9; }
  .hero-kpi .right .compare-value { font-size: 56px; font-weight: 700; }

  /* ===== KPIs secundarios (chips) ===== */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 24px 0;
  }
  .kpi {
    background: var(--gris-claro);
    border-left: 6px solid var(--verde-cmp);
    padding: 18px 22px;
    border-radius: 10px;
  }
  .kpi .label {
    font-size: 18px;
    color: var(--gris-text);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .kpi .value {
    font-size: 48px;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.1;
    margin-top: 4px;
  }
  .kpi .delta { font-size: 22px; font-weight: 700; margin-top: 4px; }

  .delta.up   { color: var(--verde-up); }
  .delta.down { color: var(--rojo); }
  .delta.flat { color: var(--gris-text); }
  /* Sobre fondo de color (hero-kpi) las flechas se ven blancas */
  .hero-kpi .delta.up   { color: white; }
  .hero-kpi .delta.down { color: #fee2e2; }
  .hero-kpi .delta.flat { color: rgba(255,255,255,0.85); }

  /* ===== Comparativa anterior vs actual (sin hero) ===== */
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 24px;
  }
  .compare .col {
    background: var(--gris-claro);
    border-radius: 12px;
    padding: 22px;
  }
  .compare .col h3 {
    font-size: 24px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .compare .col .range { font-size: 16px; color: var(--gris-text); margin-bottom: 14px; }
  .compare .col .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 14px;
  }
  .compare .col .stat .v { font-size: 34px; font-weight: 900; }
  .compare .col .stat .l { font-size: 14px; color: var(--gris-text); font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }
  .compare .col .img-wrap {
    background: white;
    border: 1px solid var(--gris-medio);
    border-radius: 8px;
    overflow: hidden;
    height: 280px;
    display: flex; align-items: center; justify-content: center;
  }
  .compare .col .img-wrap img { width: 100%; height: 100%; object-fit: contain; }
  .compare .col .img-wrap .placeholder { color: var(--gris-medio); font-size: 18px; }

  /* ===== Card genérica ===== */
  .card {
    background: var(--gris-claro);
    border-radius: 12px;
    padding: 22px 26px;
  }
  .card h3 {
    font-size: 24px;
    font-weight: 800;
    color: var(--verde-cmp-osc);
    margin-bottom: 14px;
  }
  .card .stats-grid {
    display: grid;
    gap: 10px 24px;
  }
  .card .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid var(--gris-medio);
  }
  .card .row:last-child { border-bottom: 0; }
  .card .row .l { font-size: 18px; color: var(--gris-text); }
  .card .row .v { font-size: 26px; font-weight: 800; color: #0f172a; }

  /* ===== WhatsApp ===== */
  .wa-banner { text-align: center; font-size: 40px; font-weight: 800; margin: 30px 0 30px; }
  .wa-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .wa-card { background: #0f172a; color: white; border-radius: 12px; padding: 26px 22px; text-align: center; min-height: 300px; display: flex; flex-direction: column; justify-content: space-between; }
  .wa-card .badge { background: white; color: var(--verde-cmp-osc); border-radius: 50%; width: 100px; height: 100px; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 13px; text-align: center; padding: 12px; line-height: 1.1; }
  .wa-card .name { font-size: 18px; font-weight: 600; line-height: 1.3; margin-top: 14px; }
  .wa-card .members { font-size: 15px; color: var(--gris-medio); margin-top: 10px; }

  /* ===== Web ===== */
  .web-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .web-kpi { border-radius: 10px; padding: 18px 22px; color: white; }
  .web-kpi .l { font-size: 16px; opacity: 0.95; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
  .web-kpi .v { font-size: 40px; font-weight: 900; margin-top: 4px; }
  .web-kpi.k1 { background: var(--azul); }
  .web-kpi.k2 { background: var(--verde-cmp); }
  .web-kpi.k3 { background: var(--naranja); }
  .web-list { background: var(--gris-claro); border-radius: 12px; padding: 22px; margin-top: 18px; }
  .web-list .item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--gris-medio); }
  .web-list .item:last-child { border-bottom: 0; }
  .web-list .item .ttl { font-size: 17px; font-weight: 700; }
  .web-list .item .url { font-size: 12px; color: var(--gris-text); }
  .web-list .item .clics { font-size: 22px; font-weight: 800; min-width: 70px; text-align: right; }
  .web-list .item .delta { font-size: 14px; font-weight: 700; min-width: 90px; text-align: right; }

  /* ===== YouTube ===== */
  .yt-icon {
    background: var(--rojo-yt);
    color: white;
    width: 90px; height: 64px;
    border-radius: 14px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 36px;
    margin-right: 16px;
    vertical-align: middle;
  }
  .yt-icon::after { content: "▶"; }

  /* ===== Bullets (conclusiones/oportunidades) ===== */
  .bullets { margin-top: 24px; }
  .bullets li {
    list-style: none;
    font-size: 26px;
    line-height: 1.5;
    padding: 16px 0 16px 56px;
    position: relative;
    color: #1e293b;
  }
  .bullets li::before {
    content: "✓";
    position: absolute;
    left: 0; top: 14px;
    width: 36px; height: 36px;
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    border-radius: 6px;
    font-weight: 900;
    font-size: 24px;
    display: flex; align-items: center; justify-content: center;
  }
  .bullets li b { color: #0f172a; }

  /* ===== Cierre ===== */
  .closing { display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%; text-align: center; }
  .closing h1 {
    font-size: 200px; font-weight: 900;
    background: linear-gradient(135deg, var(--verde-lima) 0%, var(--verde-cmp) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .closing img { margin-top: 40px; width: 380px; }

  /* ===== Avatar/Persona ===== */
  .person {
    display: flex; align-items: center; gap: 22px; margin-top: 18px;
  }
  .person .avatar {
    width: 110px; height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--verde-lima), var(--verde-cmp));
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 44px; font-weight: 900;
  }
  .person .info .name { font-size: 32px; font-weight: 800; }
  .person .info .role { font-size: 18px; color: var(--gris-text); }

  /* ===== Print ===== */
  @page { size: 1920px 1080px; margin: 0; }
  @media print {
    html, body {
      background: white;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .slide {
      margin: 0;
      box-shadow: none;
      page-break-after: always;
      /* Asegura que cada slide ocupe una página completa */
      break-after: page;
    }
    .toolbar { display: none !important; }
  }

  /* ===== Banner de revisión ===== */
  .review-banner {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #0f172a;
    color: white;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  }
  .review-banner .left { display: flex; align-items: center; gap: 16px; }
  .review-banner .badge {
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .review-banner .title { font-size: 17px; font-weight: 700; }
  .review-banner .subtitle { font-size: 12px; opacity: 0.7; margin-top: 2px; }
  .review-banner .actions { display: flex; gap: 10px; align-items: center; }
  .review-banner button {
    background: var(--verde-lima);
    color: var(--verde-cmp-osc);
    border: 0;
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: inherit;
  }
  .review-banner button:hover { opacity: 0.9; }
  .review-banner button.secondary {
    background: transparent;
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
  }
  .review-banner .count {
    font-size: 12px;
    opacity: 0.7;
    margin-right: 8px;
  }

  /* ===== Hint de comentarios para mobile ===== */
  .review-hint {
    background: #fef3c7;
    color: #92400e;
    padding: 12px 32px;
    font-size: 13px;
    text-align: center;
    border-bottom: 1px solid #fbbf24;
  }
  .review-hint b { color: #78350f; }

  /* ===== Caja de comentarios bajo cada slide ===== */
  .comment-box {
    max-width: 1600px;
    margin: 0 auto 32px auto;
    background: #fef9c3;
    border: 2px solid #facc15;
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .comment-box .icon {
    background: #facc15;
    color: #78350f;
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-weight: 900;
  }
  .comment-box .body { flex: 1; }
  .comment-box .label {
    font-size: 13px;
    font-weight: 700;
    color: #78350f;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .comment-box textarea {
    width: 100%;
    border: 0;
    background: transparent;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.5;
    color: #1e293b;
    resize: vertical;
    min-height: 50px;
    outline: none;
  }
  .comment-box textarea::placeholder { color: #a16207; opacity: 0.6; }
  .comment-box .saved {
    font-size: 11px;
    color: #16a34a;
    font-weight: 700;
    margin-top: 4px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .comment-box .saved.show { opacity: 1; }

  /* ===== Numerito de slide ===== */
  .slide-number {
    position: absolute;
    bottom: 30px;
    right: 50px;
    font-size: 18px;
    color: var(--gris-medio);
    font-weight: 600;
  }

  /* ===== Print ya definido arriba sigue funcionando ===== */
  @media print {
    .review-banner, .review-hint, .comment-box { display: none !important; }
    .slide-wrap {
      box-shadow: none !important;
      border-radius: 0 !important;
      max-width: none !important;
      margin: 0 !important;
      width: 1920px !important;
      height: 1080px !important;
    }
    .slide { transform: none !important; }
    .slide-number { display: none !important; }
  }
</style>
</head>
<body>

<div class="review-banner">
  <div class="left">
    <span class="badge">Borrador para revisión</span>
    <div>
      <div class="title">Reporte métricas RRSS · {{ d.mes_label }}</div>
      <div class="subtitle">Cámara de Medios de Pago</div>
    </div>
  </div>
  <div class="actions">
    <span class="count" id="commentCount">0 comentarios</span>
    <button onclick="exportarComentarios()">Exportar comentarios</button>
    <button class="secondary" onclick="limpiarComentarios()" title="Limpiar todos los comentarios">×</button>
  </div>
</div>

<div class="review-hint">
  Escribí tus observaciones en el <b>recuadro amarillo</b> que aparece debajo de cada slide. Cuando termines, hacé click en <b>"Exportar comentarios"</b> arriba a la derecha y te abrirá un email con todo listo para enviar.
</div>

{# ============================================================ Slide - Portada #}
<section class="slide">
  <div class="cover">
    <div class="deco"></div>
    <h1 class="title-xl">Reporte<br>métricas<br>RRSS</h1>
    <div class="subtitle">{{ d.mes_label }}</div>
    <img class="logo-cover" src="{{ logo_uri }}" alt="Cámara de Medios de Pago">
  </div>
</section>

{# ============================================================ Slide - Glosario #}
<section class="slide">
  <h2 class="title-lg">Glosario</h2>
  <div class="subtitle">Definiciones de las métricas usadas en este informe</div>
  <div class="logo"><img src="{{ logo_uri }}" alt=""></div>

  <div class="glosario-grid">
    <div class="gloss-item">
      <div class="term">Alcance / Miembros alcanzados</div>
      <div class="def">Cantidad de personas únicas que vieron una publicación al menos una vez.</div>
    </div>
    <div class="gloss-item">
      <div class="term">Interacciones sociales</div>
      <div class="def">Suma de reacciones, comentarios, veces compartido, guardados y envíos.</div>
    </div>
    <div class="gloss-item">
      <div class="term">Reacciones</div>
      <div class="def">Likes, "me gusta" y demás reacciones positivas a una publicación.</div>
    </div>
    <div class="gloss-item">
      <div class="term">Veces compartido</div>
      <div class="def">Cantidad de veces que un usuario compartió la publicación en su red.</div>
    </div>
    <div class="gloss-item">
      <div class="term">Veces guardado</div>
      <div class="def">Usuarios que guardaron el contenido para verlo más tarde.</div>
    </div>
    <div class="gloss-item">
      <div class="term">Envíos en LinkedIn</div>
      <div class="def">Veces que la publicación se compartió por mensaje privado dentro de LinkedIn.</div>
    </div>
    <div class="gloss-item">
      <div class="term">Tasa de interacción</div>
      <div class="def">Interacciones sobre alcance, expresado en porcentaje. Mide el "engagement".</div>
    </div>
    <div class="gloss-item">
      <div class="term">Visitantes únicos</div>
      <div class="def">Personas distintas que visitaron la página de LinkedIn de la Cámara.</div>
    </div>
    <div class="gloss-item">
      <div class="term">CTR (Search Console / YouTube)</div>
      <div class="def">Porcentaje de impresiones que se convirtieron en clics o vistas.</div>
    </div>
    <div class="gloss-item">
      <div class="term">Posición media (Search Console)</div>
      <div class="def">Posición promedio en los resultados de Google para las búsquedas registradas.</div>
    </div>
  </div>
</section>

{# ============================================================ Slide - Contenidos #}
<section class="slide">
  <h2 class="title-lg">Contenidos</h2>
  <div class="subtitle">{{ d.mes_label }} · LinkedIn — Cámara de Medios de Pago</div>
  <div class="logo"><img src="{{ logo_uri }}" alt=""></div>

  <div style="margin-top: 30px;">
    <div class="kpi-badge">KPI principal</div>
    <div class="hero-kpi">
      <div class="left">
        <div class="label">Interacciones totales</div>
        <div class="value">{{ fmt_num(totales.contenidos.actual) }}</div>
        <div class="delta {{ delta_class(deltas.interacciones_total) }}">{{ delta_str(deltas.interacciones_total) }} vs {{ d.mes_anterior_label }}</div>
      </div>
      <div class="right">
        <div class="compare-label">{{ d.mes_anterior_label }}</div>
        <div class="compare-value">{{ fmt_num(totales.contenidos.anterior) }}</div>
      </div>
    </div>
  </div>

  <div class="kpi-row" style="margin-top: 26px;">
    <div class="kpi">
      <div class="label">Reacciones</div>
      <div class="value">{{ fmt_num(d.contenidos.actual.reacciones) }}</div>
